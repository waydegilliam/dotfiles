[user]
	name = waydegilliam
    email = waydegilliam@gmail.com

[init]
    defaultBranch = master

[alias]
    root = rev-parse --show-toplevel
    branch-clean = !git-branch-clean

[core]
    pager = delta

[delta]
    side-by-side = true
    syntax-theme = GitHub
    navigate = true

# Resolve gh through PATH on both macOS and Ubuntu.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
